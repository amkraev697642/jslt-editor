{
  "name": "jslt-editor",
  "version": "0.3.2",
  "description": "Embeddable JSLT editor: highlighting, completion, hover docs, formatting and error markers (built on CodeMirror 6)",
  "license": "Apache-2.0",
  "author": "Anton Kraev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amkraev697642/jslt-editor.git"
  },
  "homepage": "https://github.com/amkraev697642/jslt-editor#readme",
  "bugs": {
    "url": "https://github.com/amkraev697642/jslt-editor/issues"
  },
  "keywords": ["jslt", "editor", "json", "codemirror", "language-support", "syntax-highlighting", "autocomplete"],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/jslt-editor.js"
    },
    "./standalone": "./dist/jslt-editor.standalone.js",
    "./codemirror": {
      "import": "./dist/jslt-editor-codemirror.js"
    },
    "./core": {
      "import": "./dist/jslt-editor-core.js"
    }
  },
  "unpkg": "./dist/jslt-editor.standalone.js",
  "jsdelivr": "./dist/jslt-editor.standalone.js",
  "files": ["README.md", "LICENSE", "dist"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/language": { "optional": true },
    "@codemirror/view": { "optional": true },
    "@lezer/highlight": { "optional": true }
  },
  "devDependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2"
  }
}
